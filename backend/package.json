{
  "name": "cuebot-backend",
  "version": "1.0.0",
  "description": "CueBot backend: inventory data, item images, and speech clips for the web interface",
  "main": "server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "start:layperson": "CUEBOT_CART=layperson node server.js",
    "start:rn": "CUEBOT_CART=rn node server.js",
    "dev": "node --watch server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Anonymous",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "socket.io": "^4.8.1"
  }
}
